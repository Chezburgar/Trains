{
  "format_version": "1.21.40",
  "minecraft:block": {
    "description": {
      "identifier": "trains:track",
      "menu_category": { "category": "construction" },
      "states": {
        "trains:shape": ["straight", "corner", "slope"]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "minecraft:geometry": "geometry.trains.track_plate",
      "minecraft:material_instances": {
        "*": { "texture": "trains_track", "render_method": "opaque" }
      },
      "minecraft:collision_box": { "origin": [-8, 0, -8], "size": [16, 2, 16] },
      "minecraft:selection_box": { "origin": [-8, 0, -8], "size": [16, 2, 16] },
      "minecraft:destructible_by_mining": { "seconds_to_destroy": 0.6 },
      "minecraft:destructible_by_explosion": { "explosion_resistance": 12 },
      "minecraft:map_color": "#6E6E6E"
    },
    "permutations": [
      {
        "condition": "q.block_state('trains:shape') == 'straight' && (q.block_state('minecraft:cardinal_direction') == 'east' || q.block_state('minecraft:cardinal_direction') == 'west')",
        "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
      },
      {
        "condition": "q.block_state('trains:shape') == 'corner'",
        "components": {
          "minecraft:material_instances": {
            "*": { "texture": "trains_track_corner", "render_method": "opaque" }
          }
        }
      },
      {
        "condition": "q.block_state('trains:shape') == 'corner' && q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
      },
      {
        "condition": "q.block_state('trains:shape') == 'corner' && q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
      },
      {
        "condition": "q.block_state('trains:shape') == 'corner' && q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": { "minecraft:transformation": { "rotation": [0, 270, 0] } }
      },
      {
        "condition": "q.block_state('trains:shape') == 'slope'",
        "components": {
          "minecraft:geometry": "geometry.trains.track_slope",
          "minecraft:selection_box": { "origin": [-8, 0, -8], "size": [16, 14, 16] }
        }
      },
      {
        "condition": "q.block_state('trains:shape') == 'slope' && q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": { "minecraft:transformation": { "rotation": [0, 90, 0] } }
      },
      {
        "condition": "q.block_state('trains:shape') == 'slope' && q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": { "minecraft:transformation": { "rotation": [0, 180, 0] } }
      },
      {
        "condition": "q.block_state('trains:shape') == 'slope' && q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": { "minecraft:transformation": { "rotation": [0, 270, 0] } }
      }
    ]
  }
}
